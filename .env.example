# OpenAI / GenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_MAX_OUTPUT_TOKENS=2048
GENAI_MAX_RETRIES=3
USE_GENAI_FOR_PROFILE_EXTRACTION=false

# Data assets
# Default local layout after clone: machine-learning/data
DS_RESOURCES_DIR=./data
DS_RAW_DIR=./data/01_raw
DS_PROCESSED_DIR=./data/03_processed
DS_INTERIM_DIR=./data/02_interim
DS_ASSET_AUTO_RELOAD=true

# Explicit asset paths
ROLE_TREE_DROPDOWN_PATH=./data/01_raw/role_tree_dropdown.json
ROLE_SKILL_MATRIX_PATH=./data/01_raw/role_skill_matrix.json
SKILL_TAXONOMY_PATH=./data/01_raw/skill_taxonomy.json
COMPETENCY_MAP_PATH=./data/01_raw/competency_map.json
QUESTION_SEED_PATH=./data/01_raw/question_seed.json
WEAKNESS_TAXONOMY_PATH=./data/01_raw/weakness_taxonomy.json
SCORING_RUBRIC_PATH=./data/01_raw/scoring_rubric.json
EVIDENCE_LADDER_MAPPING_PATH=./data/01_raw/evidence_ladder_mapping.json
ANSWER_QUALITY_DATASET_PATH=./data/01_raw/answers_dataset.csv
ANSWER_QUALITY_MANUAL_TEST_PATH=
ANSWER_QUALITY_TRAIN_PATH=./data/03_processed/train_df.csv
ANSWER_QUALITY_VAL_PATH=./data/03_processed/val_df.csv
ANSWER_QUALITY_TEST_PATH=./data/03_processed/test_df.csv

# Model outputs
MODEL_DIR=./models
ANSWER_QUALITY_MODEL_PATH=./models/answer_quality_model.keras
ANSWER_QUALITY_TOKENIZER_PATH=./models/answer_quality_tokenizer.json
ANSWER_QUALITY_META_PATH=./models/answer_quality_meta.json

# Interview business rules
MAX_MAIN_QUESTIONS=3
MIN_MAIN_QUESTIONS=3
MAX_CLARIFICATION_PER_MAIN=1
MAX_CLARIFICATION_PER_SESSION=3
MAX_AUDIO_DURATION_SECONDS=90
MAX_AUDIO_FILE_SIZE_MB=25
STT_LOW_CONFIDENCE_THRESHOLD=0.60

# STT config
STT_MODEL_SIZE=small
STT_MODEL_DEVICE=cpu
STT_MODEL_COMPUTE=int8
STT_BEAM_SIZE=5
STT_VAD_FILTER=true
